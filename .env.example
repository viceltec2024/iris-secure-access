# Local Vite and Codex preview only. Do not set these on ChatGPT Sites production.
IRIS_DEV_SKIP_STEPUP=1
IRIS_DEV_EMAIL=owner@iris.local
IRIS_OWNER_EMAIL=owner@iris.local
