# Local Vite and Codex preview only. Do not set these on ChatGPT Sites production.
IRIS_DEV_SKIP_STEPUP=1
IRIS_DEV_EMAIL=owner@iris.local
IRIS_OWNER_EMAIL=owner@iris.local
# IRIS_PUBLIC_ORIGIN=https://your-public-host
#
# Copy to .env.local (gitignored). Paste the real key after the equals sign.
# Never commit .env.local.
OPENAI_API_KEY=
# Meta Muse (Model API) — agente de edición en Ask IRIS. Key from https://dev.meta.ai
MODEL_API_KEY=
#
# ElevenLabs neural voice for Ask IRIS (/api/iris-voice).
# Without these, IRIS falls back to the browser speechSynthesis voice.
ELEVENLABS_API_KEY=
# Optional. Defaults to Sarah (EXAVITQu4vr4xnSDxMaL), a free-tier premade voice.
# ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_multilingual_v2.
# ELEVENLABS_MODEL_ID=
#
# --- Billing (Phase B test mode) ---
# Keep real charging OFF. IRIS_BILLING_LIVE must stay unset/0 until you expressly authorize production payments.
# IRIS_BILLING_TEST=1 enables simulated checkout + plan changes with chargeEnabled=false.
# IRIS_BILLING_TEST=1
# Optional Stripe test secret (sk_test_…). Live keys (sk_live_…) are blocked by code.
# STRIPE_SECRET_KEY=
# IRIS_BILLING_LIVE=0
