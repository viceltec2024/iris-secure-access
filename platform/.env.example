# IRIS Creator platform API (FastAPI) — copy to platform/iris-api/.env
# Never commit real secrets.

# SQLite (default local MVP) or PostgreSQL
# DATABASE_URL=sqlite:///./data/iris_platform.db
# DATABASE_URL=postgresql+psycopg://iris:iris@127.0.0.1:5432/iris_platform

JWT_SECRET=change-me-iris-platform-dev-only
BOOTSTRAP_ADMIN_EMAIL=admin@iris.local
BOOTSTRAP_ADMIN_PASSWORD=iris-admin-change-me
ALLOWED_MODELS=local-sim,openai:gpt-5.6-sol,anthropic:claude-sonnet-5
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SANDBOX_TIMEOUT_SECONDS=8

# Optional later phases (not required for Fase 1 MVP)
# REDIS_URL=redis://127.0.0.1:6379/0
# OPENAI_API_KEY=   # server-side only — never expose to the frontend
